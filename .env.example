# ============================================================
# 班费收支系统 · Docker Compose 环境变量模板
#
# 用法：复制一份为 .env 后按需修改
#   cp .env.example .env        # Windows: copy .env.example .env
#   docker compose up -d --build
# docker compose 会自动读取本目录的 .env（compose 文件里用 ${VAR} 引用）
#
# 约定：本文件只放「变量名 + 说明」，真实口令写在 .env；.env 含密钥，不要提交或外传。
# ============================================================

# ---------- 班主任（系统管理员）账号：声明即生效 ----------
# 启动时若库里没有这个用户名就自动创建；**已存在则跳过，不会覆盖你在页面里改过的密码**。
# 用户名与密码必须同时填写：两项都留空 = 不创建任何账号（首次部署务必填写，否则无人可登录）。
CLASSFEE_TEACHER_USERNAME=
CLASSFEE_TEACHER_PASSWORD=
# 可选：姓名（留空则与用户名相同）
CLASSFEE_TEACHER_NAME=
# 可选：角色 TEACHER=班主任（默认）/ ADMIN=生活委员（两者权限相同）
CLASSFEE_TEACHER_ROLE=TEACHER

# ---------- 安全 ----------
# JWT 签名密钥：Python 后端 config.py 读取，用于签发/校验登录令牌（改它会让已登录的人全部掉线）
# 生成：openssl rand -hex 32
CLASSFEE_JWT_SECRET=
# 登录令牌有效期（小时），默认 2
CLASSFEE_JWT_EXPIRE_HOURS=2

# ---------- 数据库 ----------
# 【A】用 docker-compose.yml（默认）：compose 自己起一个 MariaDB 容器
#   只需要填 root 口令，业务库 classfee/classfee123 由 compose 固定
DB_ROOT_PASSWORD=

# 【B】用 docker-compose.use-existing-db.yml：复用服务器上**已在运行**的 MySQL/MariaDB
#   （把下面 5 行填好；这份 compose 不会创建数据库容器，也不会碰你的数据）
#   DB_HOST：数据库地址。数据库和本应用在同一台服务器 → 127.0.0.1
#           数据库在另一台机器 → 那台机器的内网 IP 或域名
#   DB_PORT：默认 3306（MySQL）/ 33060（某些自建面板的 MySQL）

#   DB_NAME / DB_USERNAME / DB_PASSWORD：要在数据库里先建好库和账号（见部署文档 §9.6）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=classfee
DB_USERNAME=classfee
DB_PASSWORD=

# ---------- 端口与存储 ----------
# 对外 HTTP 端口（前端 nginx），默认 80
#   80 被占用时改成 8080 之类：http://服务器IP:8080
HTTP_PORT=80
# 小票图片目录（容器内路径；compose 已挂 named volume classfee_uploads，备份需连卷一起备）
CLASSFEE_UPLOAD_DIR=/app/uploads

# ============================================================
# 首次部署检查清单（docker compose up -d --build 之后逐条确认）
#
# 1) 看状态：docker compose ps          —— 三个服务都应是 healthy/running
# 2) 后端活着：docker compose exec backend python -c \
#      "import urllib.request,urllib.error as e;\
#       urllib.request.urlopen('http://127.0.0.1:8080/api/auth/me')" ; echo $?
#      —— 期望退出码 0（拿到 401 = 服务已就绪）
# 3) 首页返回 HTML：curl -sI http://127.0.0.1/ | head -1   —— 期望 HTTP/1.1 200
# 4) SPA 深链接不 404：curl -s -o /dev/null -w '%{http_code}\n' http://127.0.0.1/member-manage
#      —— 期望 200（验证 nginx 的 history 回退）
# 5) 接口能通：curl -s -X POST http://127.0.0.1/api/auth/login \
#      -H 'Content-Type: application/json' \
#      -d '{"username":"上面填的账号","password":"上面填的口令"}' | head -c 120
#      —— 期望 {"code":200,...} 与一段 token
# 6) 浏览器打开 http://服务器IP ，用 .env 里声明的账号登录；
#    **首次登录后立刻在「个人信息」页改密码**（库中已有该账号时启动不会覆盖）
#
# 常用运维：
#   docker compose logs -f backend     看后端日志（首次启动会建表 + 打印账号创建情况）
#   docker compose down                停止（保留数据）
#   docker compose down -v             停止并**删除**数据库与小票卷（不可恢复，慎用）
#   docker compose exec db sh -c 'exec mysqldump -uroot -p"$MARIADB_ROOT_PASSWORD" classfee' > backup.sql
#   docker run --rm -v classfee_uploads:/data -v "$PWD":/backup alpine \
#     tar czf /backup/uploads.tgz -C /data .
# ============================================================
